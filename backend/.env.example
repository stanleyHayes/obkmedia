# OBK MEDIA API — environment configuration

# Server
PORT=5174
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/obkmedia

# Auth — change both in production (generate a secret with `openssl rand -hex 48`)
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=Obkmedia30@gmail.com
ADMIN_PASSWORD=obkmedia-admin

# CORS (comma-separated origins)
CLIENT_ORIGIN=http://localhost:5173

# Cloudinary (optional — local disk fallback used when unset)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email via Resend (optional — console fallback used when unset)
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=Obkmedia30@gmail.com
CONTACT_FROM_EMAIL=OBK MEDIA <onboarding@resend.dev>
